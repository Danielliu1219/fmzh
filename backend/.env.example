# ============ 复制本文件为 .env 后修改 ============

# 数据库（SQLite 默认即可，无需修改）
DATABASE_URL=sqlite:///./fmzh.db

# JWT 密钥：部署前请改成随机字符串
SECRET_KEY=dev-secret-key-change-me
# Token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 文件上传：上传目录与单文件大小上限（MB）
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# ============ 大模型配置 ============
# mock=true 时不需要 API Key，返回内置示例数据，可以完整演示全流程
# 组员接入：复制为 .env 后只需填写自己的 API Key。仅体验内置示例时改为 true。
LLM_MOCK=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 保留模型思考模式；分析的额度包含思考与最终方案，不提前扣满上限。
# 不设置输出Token上限，交由模型平台决定（保留思考模式）。
LLM_ANALYSIS_TIMEOUT_SECONDS=420
