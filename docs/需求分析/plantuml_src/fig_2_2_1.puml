@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam componentStyle rectangle
actor "学生 / 管理员" as U
rectangle "浏览器客户端 Vue 3 SPA（Nginx 托管）" {
  component [登录 / 首页 / 考试 / 资料 / AI 分析 / 打卡] as FE
}
rectangle "FastAPI 后端" {
  component [routers 路由 + JWT 鉴权] as R
  component [services 业务逻辑 / LLM 调用] as S
  component [models 数据模型 SQLAlchemy] as M
}
database "MySQL 8.0" as DB
cloud "DeepSeek 大模型 API" as LLM
cloud "四川大学教务处网站" as JW
U --> FE : HTTPS
FE --> R : HTTP + JSON (JWT)
R --> S
S --> M
M --> DB
S --> LLM : API Key 仅存后端
FE --> JW : 内嵌 WebView 导入考表
@enduml