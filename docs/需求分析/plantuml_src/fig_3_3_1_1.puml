@startuml
skinparam defaultFontName "Noto Sans CJK SC"
left to right direction
actor "游客" as V
actor "学生" as ST
rectangle "账号管理" {
  usecase "1.1 注册账号" as A1
  usecase "1.2 登录系统" as A2
  usecase "1.3 账号锁定与密码找回" as A3
  usecase "1.4 编辑个人资料" as A4
  usecase "1.5 注销账号" as A5
}
V --> A1
V --> A2
ST --> A2
ST --> A4
ST --> A5
A2 ..> A3 : <<extend>>
@enduml